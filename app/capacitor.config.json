{
  "appId": "com.tabineko.app",
  "appName": "Tabi Neko",
  "webDir": "www",
  "backgroundColor": "#FAF4E8",
  "android": {
    "backgroundColor": "#FAF4E8"
  },
  "ios": {
    "backgroundColor": "#FAF4E8",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 150,
      "backgroundColor": "#F14E24",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FAF4E8",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_tabineko",
      "iconColor": "#F14E24"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
