rules_version = '2';

// Tabi Neko. trips/<owner id> is one person's trip, as a JSON string in
// "data". The owner can turn on an invite link: anyone signed in who knows
// the trip's "code" can add themselves (and only themselves) to "members",
// and members can then read the trip and change its "data". Members can
// also leave. users/<id> remembers which trip someone is planning. The
// site owner (ADMIN_UID) can read everything, for the dashboard.
// visits/<day> counts visits to the site, with nothing about the visitor.
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return request.auth.uid; }
    // The site owner's account, which can read everything for the dashboard.
    function admin() { return request.auth != null && request.auth.uid == 'ngmNqVpxwkbL3SHdXJpmHkAoUO22'; }
    function members() { return resource.data.get('members', []); }
    function newMembers() { return request.resource.data.get('members', []); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyMyEmailChanged() {
      return request.resource.data.get('emails', {}).diff(resource.data.get('emails', {}))
        .affectedKeys().hasOnly([me()]);
    }
    function goodShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'email', 'members', 'emails', 'code', 'join'])
        && d.data is string && d.data.size() < 200000
        && d.get('members', []) is list && d.get('members', []).size() <= 20
        && d.get('emails', {}) is map && d.get('code', '') is string
        && d.get('email', '') is string;
    }

    match /trips/{owner} {
      allow read: if admin() || (request.auth != null && (me() == owner || me() in members()));
      allow create: if request.auth != null && me() == owner && goodShape();
      allow delete: if request.auth != null && me() == owner;
      allow update: if request.auth != null && goodShape() && (
        // the owner can change anything
        me() == owner
        // members can change the trip itself
        || (me() in members() && changed().hasOnly(['data']))
        // joining with the invite code adds only yourself
        || (resource.data.get('code', '') != ''
            && request.resource.data.get('join', '') == resource.data.code
            && changed().hasOnly(['members', 'emails', 'join'])
            && newMembers().toSet() == members().toSet().union([me()].toSet())
            && onlyMyEmailChanged()
            && request.resource.data.emails[me()] == request.auth.token.email)
        // leaving removes only yourself
        || (me() in members()
            && changed().hasOnly(['members', 'emails'])
            && newMembers().toSet() == members().toSet().difference([me()].toSet())
            && onlyMyEmailChanged())
      );
    }

    // The visit counter: one document per day holding a number. Anyone can
    // add exactly 1; only the owner can read it.
    match /visits/{day} {
      allow read: if admin();
      allow create: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    // The app's open counter, the same way: opens/<day> holds a number.
    match /opens/{day} {
      allow read: if admin();
      allow create: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    // Reports on Ask Apollo answers (Google Play asks every AI chat for a
    // way to flag a bad answer). Anyone logged in can send one; it holds
    // the question, the answer, a reason and the language, and no account.
    // Only the owner can read or clear them.
    match /reports/{id} {
      allow read, delete: if admin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['q', 'a', 'why', 'lang', 'at'])
        && request.resource.data.q is string && request.resource.data.q.size() <= 600
        && request.resource.data.a is string && request.resource.data.a.size() <= 6000
        && request.resource.data.why in ['wrong', 'offensive', 'other']
        && request.resource.data.lang in ['en', 'ar']
        && request.resource.data.at is timestamp;
    }

    // Apollo Scout: scout/picks holds the owner's ✓/✗ on the weekly
    // suggestions (just place ids). The weekly scout task reads it without
    // signing in, so it's public to read; only the owner can change it.
    match /scout/{doc} {
      allow read: if true;
      allow write: if admin() && doc == 'picks'
        && request.resource.data.keys().hasOnly(['add', 'skip'])
        && request.resource.data.get('add', []) is list && request.resource.data.get('skip', []) is list
        && request.resource.data.get('add', []).size() <= 200 && request.resource.data.get('skip', []).size() <= 500;
    }

    // Apollo's stamp book: stamps/<id> is one person's stamps, as a JSON
    // string in "data" ({"city|place":"2026-11-02"}). Only they can read
    // and change it; the site owner can read it for the dashboard.
    match /stamps/{uid} {
      allow read: if admin() || (request.auth != null && me() == uid);
      allow delete: if request.auth != null && me() == uid;
      allow create, update: if request.auth != null && me() == uid
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string && request.resource.data.data.size() < 20000;
    }

    // Ask Apollo's daily limit: usage/<id> = {day, n}, today's number of
    // questions. The Apollo Worker writes it with the person's own login
    // token before each question. n can only go up by one, and only starts
    // again at 1 on a new day (Japan time), so nobody can reset their count.
    match /usage/{uid} {
      function today() { return math.floor(float(request.time.toMillis() + 32400000) / 86400000.0); }
      function fresh() { return request.resource.data.day == today() && request.resource.data.n == 1; }
      allow read: if admin() || (request.auth != null && me() == uid);
      // Deleting your account clears it, but not on a day it was used.
      allow delete: if request.auth != null && me() == uid && resource.data.day != today();
      allow create: if request.auth != null && me() == uid
        && request.resource.data.keys().hasOnly(['day', 'n']) && fresh();
      allow update: if request.auth != null && me() == uid
        && request.resource.data.keys().hasOnly(['day', 'n'])
        && (resource.data.day == today()
            ? request.resource.data.day == today() && request.resource.data.n == resource.data.n + 1
            : fresh());
    }

    match /users/{uid} {
      allow read: if admin() || (request.auth != null && me() == uid);
      allow delete: if request.auth != null && me() == uid;
      allow create, update: if request.auth != null && me() == uid
        && request.resource.data.keys().hasOnly(['active'])
        && request.resource.data.active is string;
    }
  }
}
