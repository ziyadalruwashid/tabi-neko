 {city:"tokyo",n:"Harry Potter Cafe",jp:"ハリー・ポッター カフェ 赤坂",cat:"food",tier:"worth",area:"Akasaka",lat:35.6731,lng:139.7365,t:"book ahead, weekends fill",cost:"lunch ~¥3k, dinner ~¥5k",dur:"80–100m",cap:"expecto patronum",tip:"Full Harry Potter themed cafe on the ground floor of Akasaka Biz Tower, right outside Akasaka station exit 3. Book on hpcafe.jp, max 4 people. Get the Hedwig cake. The fake street door is decor, enter through the tower lobby."},
 {city:"tokyo",n:"Pokemon Cafe",jp:"ポケモンカフェ 日本橋",cat:"food",tier:"worth",area:"Nihonbashi & Hamacho",lat:35.6810,lng:139.7735,t:"book 31 days ahead",cost:"~¥3,300 (meal + drink)",dur:"1.5h",cap:"pikachu latte",tip:"On the 5th floor of Nihonbashi Takashimaya. Bookings open at 6pm Japan time, 31 days before, and sell out in seconds, so be online early. Without a booking, try the walk-in queue for cancellations.",also:[["Osaka (Shinsaibashi)","Pokemon Cafe Osaka Shinsaibashi"]]},
 {city:"tokyo",n:"Moses Kebab",jp:"モーゼスさんのケバブ 秋葉原",cat:"food",tier:"worth",halal:true,area:"Akihabara",lat:35.6985,lng:139.7720,t:"late night",cost:"¥600–1,350",dur:"15m",cap:"the big kebab",tip:"Halal kebab stand by Akihabara station. Get the beef Big Kebab with extra meat, it's a huge round flatbread.",also:[["Shibuya Center Gai (open till 3am)","Moses Kebab Shibuya"],["Okachimachi","Moses Kebab Okachimachi"]]},
 {city:"tokyo",n:"Nana's Green Tea",jp:"ナナズグリーンティー 自由が丘",cat:"coffee",tier:"time",area:"Jiyugaoka",lat:35.6075,lng:139.6687,t:"afternoon",cost:"",dur:"45m",cap:"matcha everything",tip:"Matcha cafe chain that started in Jiyugaoka. Matcha lattes, matcha parfaits and Japanese rice bowls. There's one in most big stations, so grab whichever is closest.",also:[["branches all over Japan","nana's green tea"]]},
 {city:"kyoto",n:"Koé Donuts",jp:"koe donuts 京都",cat:"food",tier:"worth",area:"Downtown",lat:35.0046,lng:135.7683,t:"morning, before the queue",cost:"",dur:"30m",cap:"bamboo dome",tip:"Organic donut shop on Shinkyogoku designed by Kengo Kuma, with a ceiling of 572 woven bamboo baskets. Watch them being made, then get one with Kyoto matcha."},
 {city:"kyoto",n:"Shamisen Dojo",jp:"三味線道場",cat:"experience",tier:"worth",area:"North Kyoto",lat:35.0347,lng:135.7393,t:"book ahead",cost:"~$95",dur:"1.5h",cap:"learned shamisen!",tip:"Learn to play the shamisen with a pro instructor in Murasakino. You wear a samue, get green tea on the break, a performance from the teacher and photos and videos to take home.",book:"https://www.getyourguide.com/kyoto-l96826/kyoto-shamisen-discovery-lesson-with-professional-musician-t1293165/"},
 {city:"kobe",n:"Kobe Chinatown (Nankinmachi)",jp:"南京町",cat:"food",tier:"must",area:"Motomachi & Chinatown",lat:34.6880,lng:135.1878,t:"lunch or evening",cost:"cheap eats",dur:"1h",cap:"street food crawl",tip:"Kobe's Chinatown, a few blocks packed with street food stalls. Graze on pork buns and dumplings, then walk down to Harborland."},
 {city:"kobe",n:"Taoca Coffee",jp:"タオカコーヒー 元町",cat:"coffee",tier:"worth",area:"Motomachi & Chinatown",lat:34.6877,lng:135.1855,t:"anytime",cost:"¥¥",dur:"30m",cap:"10+ beans to try",tip:"Specialty roaster a few steps from Chinatown with ten-plus beans on rotation. Ask the baristas to taste a few before you pick."},
 {city:"kobe",n:"Kannonya",jp:"観音屋 元町本店",cat:"food",tier:"worth",area:"Motomachi & Chinatown",lat:34.6886,lng:135.1840,t:"afternoon",cost:"",dur:"30m",cap:"hot cheesecake",tip:"Kobe's famous Denmark cheesecake: a sponge base under melted Danish cheese, served hot. Eat it there while it's still warm."},
 {city:"tokyo",n:"Asakusa ROX",jp:"浅草ROX",cat:"shop",tier:"worth",area:"Asakusa & Sumida",lat:35.7129,lng:139.7928,t:"opens 10:30am",cost:"",dur:"1–2h",cap:"batting cages!",tip:"Asakusa's big shopping complex, a short walk from Senso-ji. Swing a bat at the Asakusa Batting Stadium out front, and there's the Matsuri-yu bathhouse inside if you need a soak after."},
 {city:"tokyo",n:"Wa Shaghf Café",jp:"和 Shaghf Café",cat:"coffee",tier:"worth",area:"Asakusa & Sumida",lat:35.7108,lng:139.7914,t:"opens 7am",cost:"¥1,000–2,000",dur:"45m",cap:"wa + shaghf",tip:"Japanese-meets-Arabic café (shaghf means passion), on the 2nd floor of a small building in Nishi-Asakusa, a few minutes from Kaminarimon. Opens at 7am, so it works for breakfast before Senso-ji."},
 {city:"tokyo",n:"Pineapple Games",jp:"パイナップルゲームズ",cat:"experience",tier:"worth",area:"Asakusa & Sumida",lat:35.7108,lng:139.7916,t:"opens 1pm, evenings",cost:"",dur:"2–3h",cap:"game night",tip:"Board game club in a basement in Nishi-Asakusa, with walls of games and proper game tables. Right next door to Wa Shaghf Café, so coffee first, then games."},
{"city": "tokyo", "n": "Halal Ramen Toribushi", "jp": "ハラールラーメン 鶏節", "cat": "food", "tier": "worth", "hl": "halal", "area": "Ueno & Yanaka", "lat": 35.7074, "lng": 139.7748, "t": "late lunch or late night", "cost": "¥", "dur": "40m", "cap": "chicken paitan", "tip": "Rich slow-cooked chicken broth ramen and tsukemen, two minutes from Okachimachi station. Add the ajitama egg. Open late, so it saves you after Ameyoko.", "halal": true},
{"city": "tokyo", "n": "Nikoniko Mazemen", "jp": "にこにこまぜ麺", "cat": "food", "tier": "worth", "hl": "halal", "area": "Akihabara", "lat": 35.6968, "lng": 139.7709, "t": "lunch", "cost": "¥", "dur": "30m", "cap": "brothless ramen", "tip": "Brothless mazemen and Japanese curry, all halal (not certified), a short walk from Akihabara. Mix everything at the bottom of the bowl before the first bite.", "halal": true},
{"city": "tokyo", "n": "Lala Pizza 1926", "jp": "ララピザ 1926 (WAGYUMAFIA ULTRA内)", "cat": "food", "tier": "worth", "area": "Akasaka", "lat": 35.6735, "lng": 139.7362, "t": "Saturdays only, 11:30–15:00", "cost": "¥¥", "dur": "1h", "cap": "wagyu pizza", "tip": "A Saturday-only pizza pop-up hidden inside WAGYUMAFIA ULTRA, two minutes from Akasaka station. Get the wagyu provola, and grab the house-made wagyu jerky on the way out. The beef isn't halal."},
{"city": "tokyo", "n": "Jazz Café Masako Parfum Store", "jp": "マサコ パルファン店", "cat": "coffee", "tier": "worth", "area": "Shimokitazawa", "lat": 35.6630005, "lng": 139.6666652, "t": "afternoon, closed Thu", "cost": "¥", "dur": "1h", "cap": "jazz & an toast", "tip": "The roomier second shop of Shimokitazawa's famous jazz kissa Masako, upstairs and a bit more private, like sitting in someone's living room. Big speakers, loud records, Masako blend coffee and red-bean toast with cream. Open 12:00–19:00."},
{"city": "tokyo", "n": "Jazz Miles", "jp": "ジャズ喫茶 マイルス", "cat": "gem", "tier": "time", "area": "Meidaimae", "lat": 35.669783, "lng": 139.650422, "t": "evenings, closed Sun", "cost": "¥¥", "dur": "1h", "cap": "since 1960", "tip": "A tiny jazz kissa from 1960 down a backstreet near Meidaimae station, now run by the founder's son. Brusque service is part of the charm. Come for experimental records on old speakers. Evenings only, and they also serve drinks."},
{"city": "tokyo", "n": "Jazz Bigboy", "jp": "ジャズ BIGBOY", "cat": "coffee", "tier": "worth", "area": "Jimbocho", "lat": 35.6955581, "lng": 139.7587442, "t": "afternoon, Tue–Fri", "cost": "¥", "dur": "1h", "cap": "vinyl + coffee", "tip": "Vintage-feeling jazz kissa a minute from Jimbocho station, with an unusually light, casual mood. Great sound, careful coffee. Go for the 13:00–17:00 session (the evening turns into a bar). Cash only, 12 seats, keep your voice down."},
{"city": "tokyo", "n": "Amam Dacotan", "jp": "アマムダコタン 表参道店", "cat": "food", "tier": "worth", "area": "Harajuku & Omotesando", "lat": 35.6645406, "lng": 139.7110558, "t": "before noon, closed Wed", "cost": "¥¥", "dur": "45m", "cap": "maritozzo", "tip": "The Fukuoka bakery behind the viral maritozzo, two shops facing each other in Kita-Aoyama. Get the pistachio maritozzo and a Dacotan burger. Expect a 20–30 minute queue. Some savory breads have ham, so read the labels.", "also": [["cafe&bake across the street", "AMAM DACOTAN cafe&bake Omotesando"]]},
{"city": "tokyo", "n": "Daruma Jeans Workshop", "jp": "ダルマジーンズ 原宿", "cat": "experience", "tier": "worth", "area": "Harajuku & Omotesando", "lat": 35.6698768, "lng": 139.7031797, "t": "book ahead", "cost": "≈ $146", "dur": "1h", "cap": "make your jeans", "tip": "Make your own pair of Okayama denim jeans in an hour, one minute from Harajuku station. You pick the cut and fit the patch, rivets and button yourself, and hemming is included. Booking only, no walk-ins.", "book": "https://www.headout.com/experience/daruma-jeans-making-experience-in-harajuku-tokyo-e-45218/"},
{"city": "tokyo", "n": "Shibuya Wagyu Beef", "jp": "ハラール和牛ストール 渋谷", "cat": "food", "tier": "worth", "area": "Shibuya", "lat": 35.660511, "lng": 139.6984929, "t": "snack, 11:00–22:00", "cost": "¥¥", "dur": "20m", "cap": "wagyu skewers", "tip": "Halal wagyu stall on Center Gai, five minutes from Hachiko. Get the wagyu skewers or the double wagyu cheeseburger and eat on the go. There's a prayer space upstairs.", "halal": true, "hl": "halal"},
{"city": "tokyo", "n": "age.3 GINZA", "jp": "Age.3 GINZA 揚げサンド", "cat": "food", "tier": "worth", "area": "Ginza & Tsukiji", "lat": 35.6727584, "lng": 139.7712945, "t": "afternoon snack", "cost": "¥", "dur": "20m", "cap": "fried brioche", "tip": "Takeout-only fried brioche stuffed with cream. The crème brûlée and pistachio are the ones to get. Queues run 15–45 minutes; eat it in the little park across the street. No pork on the published menu."},
{"city": "tokyo", "n": "Pizza Studio Tamaki (PST)", "jp": "ピッツァ スタジオ タマキ", "cat": "food", "tier": "worth", "area": "Roppongi & Kamiyacho", "lat": 35.655648, "lng": 139.74437, "t": "dinner, book ahead", "cost": "¥¥", "dur": "1h", "cap": "tokyo's best pizza", "tip": "One of Tokyo's top Neapolitan pizzerias, five minutes from Akabanebashi. Order the Tamaki or a margherita. Some toppings are pork (nduja, sausage, prosciutto), so pick around them. One drink per person, soft drinks are fine.", "also": [["Roppongi branch", "Pizza Studio Tamaki Roppongi"]]},
{"city": "tokyo", "n": "Ginza Sand", "jp": "銀座サンド", "cat": "food", "tier": "time", "area": "Ginza & Tsukiji", "lat": 35.6698294, "lng": 139.762159, "t": "late night, closed Sun", "cost": "¥¥", "dur": "15m", "cap": "katsu sando", "tip": "A takeout window in Ginza 7-chome making crispy cutlet sandwiches until 3am on weekdays. Get the beef salt-cutlet or the wagyu fillet sando and skip the pork ones. Bring cash."},
{"city": "tokyo", "n": "Shanty", "jp": "シャンティ 北千住", "cat": "coffee", "tier": "worth", "area": "Kita-Senju", "lat": 35.7482661, "lng": 139.8019879, "t": "morning set, closed Wed–Thu", "cost": "¥", "dur": "1h", "cap": "showa kissaten", "tip": "A Showa-era kissaten run by a sweet elderly couple: she serves, he makes every siphon coffee by hand. The menu has Ghibli-style drawings and the morning set costs less than a Starbucks. Ask if the pizza toast has ham."},
{"city": "tokyo", "n": "Coffee Valley", "jp": "コーヒーバレー", "cat": "coffee", "tier": "worth", "area": "Ikebukuro", "lat": 35.727685, "lng": 139.713072, "t": "morning", "cost": "¥", "dur": "45m", "cap": "3 peaks", "tip": "Two floors of specialty coffee five minutes from Ikebukuro's east exit. Order the 3 Peaks: espresso, macchiato and pour-over from the same beans. Wi-Fi, plugs and sofas upstairs."},
{"city": "tokyo", "n": "DILL Coffee Parlor", "jp": "ディルコーヒーパーラー", "cat": "coffee", "tier": "worth", "area": "Jimbocho", "lat": 35.6938493, "lng": 139.7634709, "t": "breakfast", "cost": "¥", "dur": "45m", "cap": "avocado toast", "tip": "A former members' salon turned coffee parlor in Kanda Nishikicho. Avocado toast on Et Nunc bread, American-style bakes and very good coffee. Pair it with a Jimbocho bookshop walk."},
{"city": "tokyo", "n": "Coffee STAIN", "jp": "コーヒー ステイン", "cat": "coffee", "tier": "time", "area": "Komagome", "lat": 35.724, "lng": 139.754, "t": "morning, closed Mon", "cost": "¥", "dur": "20m", "cap": "tiny stand", "tip": "A seven-seat coffee stand right by Honkomagome station, a short hop north of Nezu. Quick, friendly, well made. Good before Rikugien Garden."},
{"city": "tokyo", "n": "Rokumei Coffee Gransta", "jp": "ROKUMEI COFFEE CO. グランスタ丸の内", "cat": "coffee", "tier": "worth", "area": "Marunouchi & Tokyo Sta.", "lat": 35.6813365, "lng": 139.7672552, "t": "before your train", "cost": "¥", "dur": "15m", "cap": "tokyo blend", "tip": "Nara's famous roaster inside Tokyo Station (B1, outside the gates). The Tokyo Blend is sold only here. Drip bags make an easy souvenir before the shinkansen."},
{"city": "tokyo", "n": "COMFORT Stand", "jp": "COMFORT Stand 池袋", "cat": "coffee", "tier": "time", "area": "Ikebukuro", "lat": 35.732052, "lng": 139.70835, "t": "morning", "cost": "¥", "dur": "40m", "cap": "cheese toast", "tip": "A minute from Ikebukuro exit C6. Get the thick cheese toast and a carrot cake. Gluten-free sweets too, plus Wi-Fi and plugs."},
{"city": "tokyo", "n": "YEN TOWN MARKET", "jp": "YEN TOWN MARKET® 渋谷PARCO", "cat": "shop", "tier": "worth", "area": "Shibuya", "lat": 35.6621, "lng": 139.6984, "t": "with Parco", "cost": "¥¥", "dur": "30m", "cap": "nujabes forever", "tip": "The Nujabes store inside Shibuya PARCO (5F): vinyl, Samurai Champloo records, clothes and merch. A pilgrimage if you love lo-fi."},
{"city": "tokyo", "n": "Jade5", "jp": "ブレックファスト&ブランチ ジェイドファイブ", "cat": "food", "tier": "worth", "area": "Hiroo", "lat": 35.6494712, "lng": 139.7205457, "t": "go early, closed Mon", "cost": "¥¥", "dur": "1h", "cap": "american pancakes", "tip": "A tiny American diner in Hiroo with fluffy pancakes and blueberry French toast. No reservations, so go at opening (7:30). Bacon and sausage are everywhere, so order the pancakes, French toast or egg dishes without meat."},
{"city": "tokyo", "n": "COMPTOIR", "jp": "コントワー", "cat": "food", "tier": "worth", "area": "Meguro", "lat": 35.619, "lng": 139.6772, "t": "breakfast, closed Mon–Tue", "cost": "¥¥", "dur": "1h", "cap": "bread breakfast", "tip": "Hidden upstairs from Toshi Au Coeur du Pain bakery, by Toritsu-Daigaku station. Generous morning sets of bread, soup and sides, or the slow-baked French toast. Some sets come with ham, so pick the French toast or the A set."},
{"city": "tokyo", "n": "Et Nunc Daikanyama", "jp": "エトヌンク 代官山", "cat": "food", "tier": "time", "area": "Daikanyama", "lat": 35.6485, "lng": 139.703, "t": "brunch", "cost": "¥", "dur": "40m", "cap": "build-your-own brunch", "tip": "A modern bakery inside Forestgate Daikanyama, a minute from the station. Pick a few breads from the counter and make your own brunch on the terrace. Check the savory ones for ham."},
{"city": "tokyo", "n": "No.4", "jp": "No.4 ナンバーフォー", "cat": "food", "tier": "time", "area": "Kojimachi & Ichigaya", "lat": 35.6883443, "lng": 139.7362771, "t": "morning", "cost": "¥¥", "dur": "1h", "cap": "bakery breakfast", "tip": "Part bakery, part café, part wood-fired pizza place in a quiet Yonbancho street. Go in the morning for fresh bread and French toast (ask for it without bacon). Evenings lean into beer and wine."},
{"city": "tokyo", "n": "Universal Bakes and Cafe", "jp": "ユニバーサル ベイクス アンド カフェ", "cat": "food", "tier": "worth", "area": "Shimokitazawa", "lat": 35.659, "lng": 139.6625, "t": "morning, closed Mon–Tue", "cost": "¥", "dur": "30m", "cap": "100% vegan", "tip": "A fully plant-based bakery by Setagaya-Daita station: no eggs, milk or butter, so no worries about what's inside. Get the coconut melon pan and the cinnamon roll. Even non-vegans love it."},
{"city": "tokyo", "n": "Sabo Tokyo", "jp": "Sabo Tokyo 浅草橋", "cat": "coffee", "tier": "worth", "area": "Asakusabashi", "lat": 35.6985, "lng": 139.7855, "t": "anytime", "cost": "¥", "dur": "30m", "cap": "coffee or matcha", "tip": "Single-origin Colombian coffee and five matchas from Aichi, poured across a counter carved from a giant boulder. Can't choose? Order both."},
{"city": "tokyo", "n": "Lambert", "jp": "ランバート 大久保", "cat": "coffee", "tier": "worth", "area": "Shin-Okubo", "lat": 35.704, "lng": 139.696, "t": "book a table, closed Mon & Thu", "cost": "¥¥", "dur": "1h", "cap": "matcha garden", "tip": "A 70-year-old house turned matcha café near Okubo station, with a koi pond and waterfall garden. Book a table inside on TableCheck, or take your Izumo matcha latte to the garden bench. Card only, 10:30–17:00."},
{"city": "kyoto", "n": "Halal Ramen WAGYUZA", "jp": "ハラルラーメン和牛座", "cat": "food", "tier": "must", "area": "Downtown", "lat": 35.0006, "lng": 135.7598, "t": "lunch or dinner", "cost": "¥¥", "dur": "45m", "cap": "A5 wagyu ramen", "tip": "New halal ramen with A5 wagyu, five minutes from Karasuma station. Everything is made in a dedicated halal kitchen that has never touched pork, with no alcohol in the kaeshi. Get the Wagyu Ramen and pick your spice from 0 to 10. Open daily 11:30–21:00.", "halal": true, "hl": "halal", "also": [["Kiyamachi branch, near Kyoto City Hall", "Halal Ramen WAGYUZA Kiyamachi"]]},
{"city": "kyoto", "n": "Hario Cafe Kyoto", "jp": "HARIO CAFE 京都", "cat": "coffee", "tier": "time", "area": "Gion", "lat": 35.001, "lng": 135.7795, "t": "near Kodai-ji", "cost": "¥¥", "dur": "40m", "cap": "siphon coffee", "tip": "The V60 people's own café, on the stone-paved Ishibe lane near Kodai-ji. Watch them brew siphon and pour-over on Hario gear, and add the cheesecake."},
{"city": "kyoto", "n": "blend kyoto", "jp": "ブレンド京都", "cat": "coffee", "tier": "worth", "area": "Imperial Palace & Demachi", "lat": 35.016154, "lng": 135.765854, "t": "morning", "cost": "¥¥", "dur": "30m", "cap": "build your blend", "tip": "A coffee window in a 100-year-old machiya south of the Imperial Palace. You smell the bean profiles and they build a blend for you, served on a granite tray. The staff love talking coffee in English."},
{"city": "osaka", "n": "HOOP Coffee", "jp": "HOOP Coffee & Share Roaster", "cat": "coffee", "tier": "worth", "area": "Shinsaibashi & Namba", "lat": 34.677081, "lng": 135.499037, "t": "afternoon", "cost": "¥", "dur": "45m", "cap": "basement roaster", "tip": "Easy to walk past: a basement roastery two minutes from Shinsaibashi with a cozy camping vibe and the smell of fresh beans. Get a single origin and stay a while."},
{"city": "osaka", "n": "AUN Coffee Roasters", "jp": "エーユーエヌコーヒーロースターズ", "cat": "coffee", "tier": "worth", "area": "Shinsaibashi & Namba", "lat": 34.661851, "lng": 135.496037, "t": "with Namba Yasaka", "cost": "¥", "dur": "30m", "cap": "next to the lion", "tip": "Roastery a few steps from Namba Yasaka Shrine, the one with the giant lion head. Pair the two. Ask what's in the croissant sandwiches."},
{"city": "osaka", "n": "Ourlog Coffee", "jp": "OURLOG COFFEE 本町店", "cat": "coffee", "tier": "time", "area": "Honmachi", "lat": 34.6862, "lng": 135.4975, "t": "breakfast", "cost": "¥", "dur": "40m", "cap": "pastry-first", "tip": "A young pastry-first coffee brand near Honmachi. Salt bread, pistachio pretzels and a good vanilla or matcha latte."},
